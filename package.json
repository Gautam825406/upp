{
  "name": "u-plus-plus-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "U++ Academy - coaching website for Classes 6-12 in Madhygopali, Maharajgunj (JAC, CBSE, ICSE).",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "build:client": "vite build",
